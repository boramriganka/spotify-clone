{
  "name": "react-spotify-search",
  "version": "1.0.0",
  "description": "Spotify song search react-redux",
  "main": "index.js",
  "dependencies": {
    "@reduxjs/toolkit": "^1.9.7",
    "axios": "0.16.2",
    "balanced-match": "^3.0.1",
    "fast-average-color": "^9.5.2",
    "framer-motion": "^10.18.0",
    "lucide-react": "^0.284.0",
    "moment": "^2.19.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^4.11.0",
    "react-redux": "^8.1.3",
    "react-router-dom": "^6.30.3",
    "react-scripts": "^5.0.1",
    "sass": "^1.99.0"
  },
  "devDependencies": {
    "@types/minimatch": "^6.0.0",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "ajv": "^8.20.0",
    "ajv-keywords": "^5.1.0",
    "cross-env": "^7.0.3",
    "typescript": "^4.1.3"
  },
  "scripts": {
    "build-css": "sass src:src --no-source-map",
    "watch-css": "sass src:src --watch --no-source-map",
    "start": "cross-env NODE_OPTIONS=--openssl-legacy-provider PORT=3008 react-scripts start",
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider react-scripts build",
    "test": "cross-env NODE_OPTIONS=--openssl-legacy-provider react-scripts test --env=jsdom",
    "eject": "react-scripts eject",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
